    {
      "name": "b4f9feb3",
      "displayName": "total encounters in each class",
      "queryLines": [
        "-- b. For each year, what percentage of all encounters belonged to each encounter class\r\n",
        "-- (ambulatory, outpatient, wellness, urgent care, emergency, and inpatient)?\r\n",
        "\r\n",
        "SELECT YEAR(START) AS `Year`, COUNT(*) AS total_encounters,\r\n",
        "  ROUND(SUM(CASE WHEN ENCOUNTERCLASS = 'ambulatory' THEN 1 ELSE 0 END) * 100.0 / COUNT(*), 2) AS ambulatory_percentage,\r\n",
        "  ROUND(SUM(CASE WHEN ENCOUNTERCLASS = 'outpatient' THEN 1 ELSE 0 END) * 100.0 / COUNT(*), 2) AS outpatient_percentage,\r\n",
        "  ROUND(SUM(CASE WHEN ENCOUNTERCLASS = 'wellness' THEN 1 ELSE 0 END) * 100.0 / COUNT(*), 2) AS wellness_percentage,\r\n",
        "  ROUND(SUM(CASE WHEN ENCOUNTERCLASS = 'urgentcare' THEN 1 ELSE 0 END) * 100.0 / COUNT(*), 2) AS urgent_care_percentage,\r\n",
        "  ROUND(SUM(CASE WHEN ENCOUNTERCLASS = 'emergency' THEN 1 ELSE 0 END) * 100.0 / COUNT(*), 2) AS emergency_percentage,\r\n",
        "  ROUND(SUM(CASE WHEN ENCOUNTERCLASS = 'inpatient' THEN 1 ELSE 0 END) * 100.0 / COUNT(*), 2) AS inpatient_percentage \r\n",
        "  FROM default.encounters\r\n",
        "GROUP BY YEAR(START) \r\n",
        "ORDER BY YEAR(START)"
      ],
      "catalog": "hospital_records_mavena",
      "schema": "default"
    },
    {
      "name": "4085bde5",
      "displayName": "zero payer coverage",
      "queryLines": [
        "SELECT COUNT(*) AS total_encounters, \r\n",
        "  SUM(CASE WHEN payer_coverage = 0 THEN 1 ELSE 0 END) AS zero_payer_coverage_total,\r\n",
        "  ROUND(SUM(CASE WHEN payer_coverage = 0 THEN 1 ELSE 0 END) / COUNT(*) * 100.0, 2) AS zero_payer_coverage_percentage\r\n",
        "  FROM default.encounters"
      ],
      "catalog": "hospital_records_mavena",
      "schema": "default"
    },
    {
      "name": "4666cecf",
      "displayName": "avg claim cost per payer",
      "queryLines": [
        "-- d. What is the average total claim cost for encounters, broken down by payer?\r\n",
        "SELECT p.name, ROUND(AVG(total_claim_cost), 2) AS average_total_claim_cost FROM encounters e\r\n",
        "LEFT JOIN payers p\r\n",
        "ON e.Payer = p.id\r\n",
        "GROUP BY p.name\r\n",
        "ORDER BY average_total_claim_cost DESC"
      ],
      "catalog": "hospital_records_mavena",
      "schema": "default"
    },
    {
      "name": "encounters_by_class",
      "displayName": "Encounters by Class Distribution",
      "queryLines": [
        "SELECT\n",
        "  ENCOUNTERCLASS AS class,\n",
        "  COUNT(*) AS encounter_count\n",
        "FROM\n",
        "  hospital_records_mavena.default.encounters\n",
        "GROUP BY\n",
        "  ENCOUNTERCLASS\n",
        "ORDER BY\n",
        "  encounter_count DESC"
      ]
    }
  ],
